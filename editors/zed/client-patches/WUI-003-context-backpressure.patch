@@ -0,0 +1,347 @@
+use super::*;
+use futures::channel::oneshot;
+use gpui::TestAppContext;
+use language::rust_lang;
+use lsp::FakeLanguageServer;
+use parking_lot::Mutex;
+use project::FakeFs;
+use serde_json::json;
+use util::path;
+
+#[derive(Default)]
+struct Requests {
+    automatic: Vec<(&'static str, lsp::Position)>,
+    pending: Vec<oneshot::Sender<()>>,
+    manual_armed: bool,
+    manual_seen: bool,
+}
+
+#[gpui::test]
+async fn background_context_bounds_admission_preserves_all_results_and_manual_navigation(
+    cx: &mut TestAppContext,
+) {
+    let (project, buffer, server, _document_lsp) = fixture(cx).await;
+    let requests = Arc::new(Mutex::new(Requests::default()));
+    handlers(&server, requests.clone());
+    let store = refresh(&project, &buffer, cx);
+    assert_eq!(
+        requests.lock().automatic.len(),
+        2,
+        "background context must admit one identifier pair, not all 32 pairs eagerly"
+    );
+
+    requests.lock().manual_armed = true;
+    let manual = project.update(cx, |project, cx| project.definitions(&buffer, 4usize, cx));
+    cx.run_until_parked();
+    assert!(
+        requests.lock().manual_seen,
+        "manual navigation must reach the server while the automatic pair is pending"
+    );
+    assert_eq!(
+        requests.lock().automatic.len(),
+        2,
+        "later speculative positions must remain unissued"
+    );
+    assert!(
+        manual
+            .await
+            .expect("manual request")
+            .expect("capable server")
+            .is_empty()
+    );
+    requests.lock().manual_armed = false;
+
+    for _ in 0..32 {
+        let pending = std::mem::take(&mut requests.lock().pending);
+        assert!(!pending.is_empty() && pending.len() <= 2);
+        for response in pending {
+            response.send(()).expect("one response per live request");
+        }
+        cx.run_until_parked();
+    }
+    let actual = requests.lock().automatic.clone();
+    assert_eq!(
+        actual.len(),
+        64,
+        "backpressure must not truncate identifiers or omit type definitions"
+    );
+    let distinct: std::collections::BTreeSet<_> = actual
+        .iter()
+        .map(|(method, position)| (*method, position.line, position.character))
+        .collect();
+    assert_eq!(distinct.len(), 64);
+    assert!(requests.lock().pending.is_empty());
+    assert!(
+        store
+            .update(cx, |store, cx| store.related_files(cx))
+            .is_empty(),
+        "the server returned no locations"
+    );
+
+    let position = buffer.read_with(cx, |buffer, _| buffer.anchor_before(buffer.len() - 3));
+    store.update(cx, |store, cx| store.refresh(buffer.clone(), position, cx));
+    cx.executor().advance_clock(DEBOUNCE_DURATION);
+    cx.run_until_parked();
+    assert_eq!(
+        requests.lock().automatic.len(),
+        64,
+        "unchanged warm context retains every cache hit"
+    );
+}
+
+#[gpui::test]
+async fn disposing_context_does_not_create_the_rest_of_its_speculative_requests(
+    cx: &mut TestAppContext,
+) {
+    let (project, buffer, server, _document_lsp) = fixture(cx).await;
+    let requests = Arc::new(Mutex::new(Requests::default()));
+    handlers(&server, requests.clone());
+    let store = refresh(&project, &buffer, cx);
+    assert_eq!(requests.lock().automatic.len(), 2);
+    drop(store);
+    for response in std::mem::take(&mut requests.lock().pending) {
+        response
+            .send(())
+            .expect("finish the already admitted request");
+    }
+    cx.run_until_parked();
+    assert_eq!(
+        requests.lock().automatic.len(),
+        2,
+        "a dead context cannot issue its remaining identifiers"
+    );
+    assert!(requests.lock().pending.is_empty());
+}
+
+#[gpui::test]
+async fn a_new_refresh_stops_old_unissued_positions_without_publishing_a_partial_cache(
+    cx: &mut TestAppContext,
+) {
+    obsolete_context(Invalidation::Cursor, cx).await;
+}
+
+#[gpui::test]
+async fn a_source_edit_stops_old_unissued_positions_without_publishing_a_partial_cache(
+    cx: &mut TestAppContext,
+) {
+    obsolete_context(Invalidation::Source, cx).await;
+}
+
+#[gpui::test]
+async fn a_context_policy_change_stops_old_unissued_positions(cx: &mut TestAppContext) {
+    obsolete_context(Invalidation::Policy, cx).await;
+}
+
+enum Invalidation {
+    Cursor,
+    Source,
+    Policy,
+}
+
+#[gpui::test]
+async fn an_identical_refresh_does_not_starve_the_active_context(cx: &mut TestAppContext) {
+    let (project, buffer, server, _document_lsp) = fixture(cx).await;
+    let requests = Arc::new(Mutex::new(Requests::default()));
+    handlers(&server, requests.clone());
+    let store = refresh(&project, &buffer, cx);
+    let position = buffer.read_with(cx, |buffer, _| buffer.anchor_before(buffer.len() - 3));
+    store.update(cx, |store, cx| store.refresh(buffer.clone(), position, cx));
+    for _ in 0..32 {
+        let pending = std::mem::take(&mut requests.lock().pending);
+        assert!(!pending.is_empty() && pending.len() <= 2);
+        for response in pending {
+            response.send(()).expect("continue the identical input");
+        }
+        cx.run_until_parked();
+    }
+    cx.executor().advance_clock(DEBOUNCE_DURATION);
+    cx.run_until_parked();
+    assert_eq!(requests.lock().automatic.len(), 64);
+    assert!(requests.lock().pending.is_empty());
+}
+
+async fn obsolete_context(change: Invalidation, cx: &mut TestAppContext) {
+    let (project, buffer, server, _document_lsp) = fixture(cx).await;
+    let requests = Arc::new(Mutex::new(Requests::default()));
+    handlers(&server, requests.clone());
+    let store = refresh(&project, &buffer, cx);
+    let outcomes = cx.new(|_| Vec::<bool>::new());
+    let _subscription = outcomes.update(cx, |_, cx| {
+        cx.subscribe(&store, |outcomes, _, event, _| {
+            if let RelatedExcerptStoreEvent::FinishedRefresh { superseded, .. } = event {
+                outcomes.push(*superseded);
+            }
+        })
+    });
+    assert_eq!(requests.lock().automatic.len(), 2);
+    match change {
+        Invalidation::Source => {
+            buffer.update(cx, |buffer, cx| {
+                buffer.edit([(0..0, "// user edit\n")], None, cx)
+            });
+        }
+        Invalidation::Cursor => {
+            let position = buffer.read_with(cx, |buffer, _| buffer.anchor_before(buffer.len() - 5));
+            store.update(cx, |store, cx| store.refresh(buffer.clone(), position, cx));
+        }
+        Invalidation::Policy => store.update(cx, |store, _| store.set_identifier_line_count(1)),
+    }
+    for response in std::mem::take(&mut requests.lock().pending) {
+        response.send(()).expect("finish the old pair");
+    }
+    cx.run_until_parked();
+    assert_eq!(
+        requests.lock().automatic.len(),
+        2,
+        "superseded work must not start a second pair"
+    );
+    assert!(requests.lock().pending.is_empty());
+    assert_eq!(
+        outcomes.read_with(cx, |outcomes, _| outcomes.clone()),
+        vec![true]
+    );
+    if !matches!(change, Invalidation::Cursor) {
+        let position = buffer.read_with(cx, |buffer, _| buffer.anchor_before(buffer.len() - 3));
+        store.update(cx, |store, cx| store.refresh(buffer.clone(), position, cx));
+    }
+    cx.executor().advance_clock(DEBOUNCE_DURATION);
+    cx.run_until_parked();
+    for _ in 0..32 {
+        let pending = std::mem::take(&mut requests.lock().pending);
+        assert!(!pending.is_empty() && pending.len() <= 2);
+        for response in pending {
+            response.send(()).expect("finish a current pair");
+        }
+        cx.run_until_parked();
+    }
+    assert_eq!(
+        requests.lock().automatic.len(),
+        66,
+        "the current context needs all 64 fresh replies; no old partial cache can certify it"
+    );
+    if matches!(change, Invalidation::Source) {
+        let requests = requests.lock();
+        assert!(
+            requests.automatic[..2]
+                .iter()
+                .all(|(_, position)| position.line == 0)
+        );
+        assert!(
+            requests.automatic[2..]
+                .iter()
+                .all(|(_, position)| position.line == 1),
+            "the unsaved inserted line must be reflected in every newly issued request"
+        );
+    }
+    assert!(requests.lock().pending.is_empty());
+    assert_eq!(
+        outcomes.read_with(cx, |outcomes, _| outcomes.clone()),
+        vec![true, false],
+        "obsolete and current refreshes must each end once with distinguishable outcomes"
+    );
+}
+
+fn refresh(
+    project: &Entity<Project>,
+    buffer: &Entity<Buffer>,
+    cx: &mut TestAppContext,
+) -> Entity<RelatedExcerptStore> {
+    let store = cx.new(|cx| RelatedExcerptStore::new(project, cx));
+    let position = buffer.read_with(cx, |buffer, _| buffer.anchor_before(buffer.len() - 3));
+    store.update(cx, |store, cx| {
+        store.set_identifier_line_count(0);
+        store.refresh(buffer.clone(), position, cx);
+    });
+    cx.executor().advance_clock(DEBOUNCE_DURATION);
+    cx.run_until_parked();
+    store
+}
+
+fn handlers(server: &FakeLanguageServer, requests: Arc<Mutex<Requests>>) {
+    server.set_request_handler::<lsp::request::GotoDefinition, _, _>({
+        let requests = requests.clone();
+        move |params, _| {
+            let release = admitted(
+                &requests,
+                "definition",
+                params.text_document_position_params.position,
+            );
+            async move {
+                if let Some(release) = release {
+                    release.await?;
+                }
+                Ok(None)
+            }
+        }
+    });
+    server.set_request_handler::<lsp::request::GotoTypeDefinition, _, _>(move |params, _| {
+        let release = admitted(
+            &requests,
+            "typeDefinition",
+            params.text_document_position_params.position,
+        );
+        async move {
+            if let Some(release) = release {
+                release.await?;
+            }
+            Ok(None)
+        }
+    });
+}
+
+fn admitted(
+    requests: &Mutex<Requests>,
+    method: &'static str,
+    position: lsp::Position,
+) -> Option<oneshot::Receiver<()>> {
+    let mut requests = requests.lock();
+    if requests.manual_armed && method == "definition" && position == lsp::Position::new(0, 4) {
+        requests.manual_seen = true;
+        return None;
+    }
+    let (release, waiting) = oneshot::channel();
+    requests.automatic.push((method, position));
+    requests.pending.push(release);
+    Some(waiting)
+}
+
+async fn fixture(
+    cx: &mut TestAppContext,
+) -> (
+    Entity<Project>,
+    Entity<Buffer>,
+    FakeLanguageServer,
+    Box<dyn std::any::Any>,
+) {
+    let settings = cx.update(|cx| settings::SettingsStore::test(cx));
+    cx.set_global(settings);
+    let fs = FakeFs::new(cx.executor());
+    let arguments = (0..40)
+        .map(|index| format!("name{index:02}"))
+        .collect::<Vec<_>>()
+        .join(", ");
+    fs.insert_tree(
+        path!("/root"),
+        json!({ "main.rs": format!("fn inspect() {{ choose({arguments}); }}") }),
+    )
+    .await;
+    let project = Project::test(fs, [path!("/root").as_ref()], cx).await;
+    let (registry, fs) = project.read_with(cx, |project, _| {
+        (project.languages().clone(), project.fs().clone())
+    });
+    let language = rust_lang();
+    registry.add(language.clone());
+    let mut servers = fake_definition_lsp::register_fake_definition_server(&registry, language, fs);
+    let (buffer, handle) = project
+        .update(cx, |project, cx| {
+            project.open_local_buffer_with_lsp(path!("/root/main.rs"), cx)
+        })
+        .await
+        .expect("open synchronized buffer");
+    let server = servers
+        .next()
+        .await
+        .expect("real project language-server connection");
+    cx.run_until_parked();
+    (project, buffer, server, Box::new(handle))
+}
