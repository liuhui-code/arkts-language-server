{
  "name": "arkts-language-server",
  "version": "0.1.0-local-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "check:fast": "pnpm test",
    "check:release": "pnpm check:fast && node --test --test-concurrency=1 tests/release/*.acceptance.mjs",
    "test": "pnpm check && pnpm build && node --test --test-concurrency=1 tests/*.test.mjs tests/**/*.test.mjs"
  },
  "dependencies": {
    "typescript": "5.9.2",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "esbuild": "0.25.9"
  },
  "engines": {
    "node": ">=20"
  }
}
